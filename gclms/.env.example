# ================================================
# GCLMS — Environment Variables
# ================================================
# Copy this file to .env and fill in appropriate values.
# NEVER commit .env to version control.

# --- General ---
APP_ENV=development
APP_NAME=GCLMS
APP_DEBUG=true

# --- URLs ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_DB=gclms
POSTGRES_USER=gclms
POSTGRES_PASSWORD=gclms
DATABASE_URL=postgresql+asyncpg://gclms:gclms@postgres:5432/gclms

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT / Auth ---
JWT_SECRET=replace-this-with-a-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gclms-files
S3_REGION=us-east-1

# --- Mail (Mailpit for dev) ---
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@gclms.local

# --- Observability (optional, leave empty for dev) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
